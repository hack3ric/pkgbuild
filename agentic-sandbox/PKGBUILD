pkgname=agentic-sandbox
pkgver=0.1.2
pkgrel=1
pkgdesc='Small Python wrapper around mkosi or podman for isolating LLM agents'
arch=('any')
url='https://github.com/hack3ric/agentic-sandbox'
license=('BSD-2-Clause')
conflicts=('agentic-sandbox-git')
depends=(
  'python'
  'fakeroot'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  'mkosi: mkosi backend support'
  'qemu-system-x86: mkosi VM support'
  'socat: mkosi port forwarding support'
  'podman: podman backend support'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('03668894e5b3e5ece6c41b57dc41f313c80faaadffab70d1973b3fcdeddf5189')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -v
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
