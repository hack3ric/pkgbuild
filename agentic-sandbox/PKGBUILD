pkgname=agentic-sandbox
pkgver=0.1.5
pkgrel=1
pkgdesc='Small Python wrapper around mkosi or podman for isolating LLM agents'
arch=('any')
url='https://github.com/hack3ric/agentic-sandbox'
license=('BSD-2-Clause')
depends=(
  'bash'
  'python'
  'fakeroot'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  'mkosi: mkosi backend support'
  'qemu-system-x86: mkosi VM support'
  'socat: mkosi port forwarding support'
  'podman: podman backend support'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6fb6b5e9acd0e237f1ffae969b36e9b9d2b21a2cc4591ead178297ed9c409ae6')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -v
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm755 agentic-container "$pkgdir/usr/bin/agentic-container"
  install -Dm755 agentic-vm "$pkgdir/usr/bin/agentic-vm"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
