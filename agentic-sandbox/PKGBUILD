pkgname=agentic-sandbox
pkgver=0.1.1
pkgrel=1
pkgdesc='Small Python wrapper around mkosi or podman for isolating LLM agents'
arch=('any')
url='https://github.com/hack3ric/agentic-sandbox'
license=('BSD-2-Clause')
conflicts=('agentic-sandbox-git')
depends=(
  'python'
  'fakeroot'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
optdepends=(
  'mkosi: mkosi backend support'
  'qemu-system-x86: mkosi VM support'
  'socat: mkosi port forwarding support'
  'podman: podman backend support'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('314cc461ea5cbd9555d67ea97063c753794e2eeeebe8891143c08a30c4d8c895')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -v
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
